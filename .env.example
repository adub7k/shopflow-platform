# ShopFlow Platform — environment variables
# Copy to Railway (or a local .env loader). NEVER commit real values.

# ── Required in production (server refuses to boot without them) ──────────────
JWT_SECRET=
ADMIN_KEY=

# ── Web push notifications (PWA) ───────────────────────────────────────────────
# Generate a keypair once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:aidan@shopflowtech.com

# ── SMS (Twilio) ────────────────────────────────────────────────────────────────
# SMS_ENABLED is intentionally NOT set — all Twilio SMS from the website-leads
# and automations modules is gated OFF until A2P 10DLC approval. Do not set it
# to true until the brand/campaign is approved. Alerts flow via push + email.
# SMS_ENABLED=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Owner email alerts (nodemailer) ────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional visible From address (set when SMTP_USER isn't a real mailbox):
SMTP_FROM=

# ── Payments ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── AI receptionist ────────────────────────────────────────────────────────────
# One key powers both: voicemail transcript analysis (RECEPTIONIST_MODEL) and the
# live conversational phone receptionist (VOICE_AI_MODEL). Per-shop opt-in is in
# Settings → AI Receptionist / AI Phone Receptionist; with no key set, both
# degrade gracefully (voicemail flow untouched).
ANTHROPIC_API_KEY=
# RECEPTIONIST_MODEL=claude-opus-4-8
# VOICE_AI_MODEL=claude-haiku-4-5   # live-call model: fast + cheap for turn-taking
# ConversationRelay (streaming voice) engine — opt-in per shop via Settings.
# Needs PUBLIC_URL set (the wss:// socket URL is derived from it) and
# ConversationRelay enabled on the Twilio account. RELAY_SECRET signs the socket
# handshake (falls back to JWT_SECRET if unset).
# RELAY_SECRET=

# ── Misc ───────────────────────────────────────────────────────────────────────
# DATA_DIR=/data
# DEFAULT_TZ=America/Denver
# PUBLIC_URL=
